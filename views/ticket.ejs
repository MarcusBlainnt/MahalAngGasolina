<div class="py-10" x-data="{ openModal: false }">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
        
        <!-- TOP SECTION: 2 CARDS SIDE-BY-SIDE -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            
            <!-- Card 1: Trip Info -->
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg border border-gray-200">
                <div class="p-4 bg-blue-600 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-white">Trip Ticket #<%= ticket.id %></h3>
                    <a href="/trip-tickets/<%= ticket.id %>/print" target="_blank" class="bg-white text-blue-600 hover:bg-blue-50 font-bold py-1 px-3 rounded text-sm flex items-center shadow-sm transition">
                        <i class="fas fa-print mr-1"></i>
                        Print
                    </a>
                </div>
                <div class="p-6 text-gray-900 space-y-2">
                    <p><span class="font-bold text-gray-600">RIV No:</span> 
                        <% if (typeof riv !== 'undefined' && riv) { %>
                            <a href="/fuel-rivs/<%= riv.id %>" class="text-blue-600 hover:underline"><%= riv.riv_no %></a>
                        <% } else { %>
                            <span class="text-gray-400">N/A</span>
                        <% } %>
                    </p>
                    <p><span class="font-bold text-gray-600">Driver:</span> <%= ticket.driver_name %></p>
                    <p><span class="font-bold text-gray-600">Plate No:</span> <%= ticket.plate_number %></p>
                    <p><span class="font-bold text-gray-600">Destination:</span> <%= ticket.destination %></p>
                    <p><span class="font-bold text-gray-600">Purpose:</span> <%= ticket.purpose %></p>
                    <p><span class="font-bold text-gray-600">Passengers:</span> <%= ticket.authorized_passengers %></p>
                    <p><span class="font-bold text-gray-600">Gasoline (Issued) (L):</span> 
                        <% 
                            let issued = 0;
                            if (typeof riv !== 'undefined' && riv && riv.items) {
                                issued = riv.items.reduce((sum, item) => sum + parseFloat(item.quantity_liters), 0);
                            }
                        %>
                        <%= issued.toFixed(2) %>
                    </p>
                    <div class="flex items-center gap-4 mt-4">
                        <p><span class="font-bold text-gray-600">Status:</span> 
                            <span class="px-2 py-1 text-xs font-semibold rounded-full <%= ticket.status === 'Completed' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                <%= ticket.status %>
                            </span>
                        </p>
                        <% if (ticket.status === 'Pending') { %>
                            <form action="/trip-tickets/<%= ticket.id %>/update-status" method="POST">
                                <input type="hidden" name="status" value="Completed">
                                <button type="submit" class="bg-green-100 hover:bg-green-200 text-green-800 border border-green-300 text-xs font-bold py-1 px-3 rounded shadow-sm transition">Mark as Completed</button>
                            </form>
                        <% } else if (ticket.status === 'Completed') { %>
                            <form action="/trip-tickets/<%= ticket.id %>/update-status" method="POST">
                                <input type="hidden" name="status" value="Pending">
                                <button type="submit" class="bg-yellow-100 hover:bg-yellow-200 text-yellow-800 border border-yellow-300 text-xs font-bold py-1 px-3 rounded shadow-sm transition">Revert to Pending</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Card 2: Consumption Form -->
            <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg border border-gray-200">
                <div class="p-4 bg-indigo-600">
                    <h3 class="text-lg font-bold text-white">Record Consumption</h3>
                </div>
                <div class="p-6">
                    <% 
                        // Get defaults from the last log if it exists
                        let consumptionLog = {};
                        if (typeof logs !== 'undefined' && logs && logs.length > 0) {
                            // Helper to find the latest non-zero value for a field
                            const findLatest = (key) => {
                                for (let i = logs.length - 1; i >= 0; i--) {
                                    if (logs[i][key] && parseFloat(logs[i][key]) !== 0) return logs[i][key];
                                }
                                return 0;
                            };
                            
                            // Construct a composite log object with the latest values
                            consumptionLog = {
                                gasoline_purchased_outside: findLatest('gasoline_purchased_outside'),
                                oil_used: findLatest('oil_used'),
                                grease_used: findLatest('grease_used'),
                                brake_fluid_used: findLatest('brake_fluid_used'),
                                gear_oil_used: findLatest('gear_oil_used'),
                                balance_in_tank_start: findLatest('balance_in_tank_start'),
                                balance_in_tank_end: findLatest('balance_in_tank_end'),
                                gasoline_used: findLatest('gasoline_used'),
                                gasoline_excess: findLatest('gasoline_excess')
                            };
                        }
                    %>
                    <form action="/trip-tickets/<%= ticket.id %>/update-consumption" method="POST" class="grid grid-cols-2 gap-4" id="consumption-form">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Gasoline (Outside) (L)</label>
                            <input type="number" step="0.01" id="gasoline_purchased_outside" name="gasoline_purchased_outside" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 p-2 border" value="<%= consumptionLog.gasoline_purchased_outside || 0 %>">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Oil (L)</label>
                            <input type="number" step="0.01" name="oil_used" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 p-2 border" value="<%= consumptionLog.oil_used || 0 %>">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Grease</label>
                            <input type="number" step="0.01" name="grease_used" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 p-2 border" value="<%= consumptionLog.grease_used || 0 %>">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Brake Fluid</label>
                            <input type="number" step="0.01" name="brake_fluid_used" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 p-2 border" value="<%= consumptionLog.brake_fluid_used || 0 %>">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Gear Oil</label>
                            <input type="number" step="0.01" name="gear_oil_used" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 p-2 border" value="<%= consumptionLog.gear_oil_used || 0 %>">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Fuel Tank Start</label>
                            <input type="number" step="0.01" id="balance_in_tank_start" name="balance_in_tank_start" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 p-2 border" value="<%= consumptionLog.balance_in_tank_start || 0 %>">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Fuel Tank End</label>
                            <input type="number" step="0.01" id="balance_in_tank_end" name="balance_in_tank_end" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 p-2 border" value="<%= consumptionLog.balance_in_tank_end || 0 %>">
                        </div>
                        
                        <!-- Hidden fields for calculation logic to work if referenced by JS, though mostly visually -->
                        <input type="hidden" id="gasoline_used" name="gasoline_used" value="<%= consumptionLog.gasoline_used || 0 %>">
                        <input type="hidden" id="gasoline_issued" value="<%= issued %>">
                        <input type="hidden" id="gasoline_excess" name="gasoline_excess" value="<%= consumptionLog.gasoline_excess || 0 %>">

                        <div class="col-span-2">
                            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded transition">
                                Save Consumption
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- BOTTOM SECTION: TABLE CARD -->
        <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg border border-gray-200">
            <div class="p-4 bg-gray-800 flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">Travel History</h3>
                <button @click.prevent="openModal = true" class="bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold py-2 px-4 rounded transition">
                    + Add Entry
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-gray-50 border-b">
                        <tr>
                            <th colspan="2" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase border-b">Departure</th>
                            <th colspan="2" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase border-b">Arrival</th>
                            <th colspan="3" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase border-b">Odometer</th>
                        </tr>
                        <tr>
                            <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Time</th>
                            <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Place</th>
                            <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Time</th>
                            <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Place</th>
                            <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Beginning</th>
                            <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Ending</th>
                            <th class="px-6 py-3 text-xs font-medium text-gray-500 uppercase">Distance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% const travelLogs = (typeof logs !== 'undefined' && logs) ? logs.filter(l => l.dep_time || l.dep_place || l.arr_time || l.arr_place) : []; %>
                        <% if (travelLogs.length > 0) { %>
                            <% travelLogs.forEach(log => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 text-sm text-gray-600"><%= log.dep_time ? new Date(log.dep_time).toLocaleString() : '-' %></td>
                                <td class="px-6 py-4 text-sm text-gray-600"><%= log.dep_place %></td>
                                <td class="px-6 py-4 text-sm text-gray-600"><%= log.arr_time ? new Date(log.arr_time).toLocaleString() : '-' %></td>
                                <td class="px-6 py-4 text-sm text-gray-600"><%= log.arr_place %></td>
                                <td class="px-6 py-4 text-sm text-gray-600"><%= log.odo_beginning %></td>
                                <td class="px-6 py-4 text-sm font-bold text-blue-600"><%= log.odo_ending %></td>
                                <td class="px-6 py-4 text-sm font-bold"><%= (log.odo_ending - log.odo_beginning).toFixed(2) %></td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-8 text-center text-gray-500">No travel history recorded yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add Travel Log Modal -->
    <div x-show="openModal" class="fixed inset-0 z-50 overflow-y-auto" style="display: none;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <!-- Background overlay -->
            <div x-show="openModal" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" @click="openModal = false"></div>

            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

            <!-- Modal panel -->
            <div x-show="openModal" x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
                
                <form method="post" action="/trip-tickets/<%= ticket.id %>/add-log" class="p-6">
                    <div class="flex justify-between items-center mb-5">
                        <h2 class="text-lg font-medium text-gray-900" id="modal-title">Add New Travel Entry</h2>
                        <button type="button" @click="openModal = false" class="text-gray-400 hover:text-gray-500">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Departure Date</label>
                            <input type="datetime-local" name="dep_time" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Arrival Date</label>
                            <input type="datetime-local" name="arr_time" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Departure Place</label>
                            <input type="text" name="dep_place" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Arrival Place</label>
                            <input type="text" name="arr_place" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Beginning Odometer</label>
                            <input type="number" step="0.01" name="odo_beginning" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Ending Odometer</label>
                            <input type="number" step="0.01" name="odo_ending" class="w-full border-gray-300 rounded-md shadow-sm border p-2 text-sm">
                        </div>
                    </div>

                    <div class="mt-6 flex justify-end gap-3">
                        <button type="button" @click="openModal = false" class="px-4 py-2 bg-white border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 bg-blue-600 border border-transparent rounded-md shadow-sm text-sm font-medium text-white hover:bg-blue-700">
                            Save Entry
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('consumption-form');
            const gasolineUsedInput = document.getElementById('gasoline_used');
            const gasolineIssuedInput = document.getElementById('gasoline_issued');
            const gasolineExcessInput = document.getElementById('gasoline_excess');
            const purchasedInput = document.getElementById('gasoline_purchased_outside');
            const startBalanceInput = document.getElementById('balance_in_tank_start');
            const endBalanceInput = document.getElementById('balance_in_tank_end');

            function calculateGasolineUsed() {
                const startBalance = parseFloat(startBalanceInput.value) || 0;
                const purchased = parseFloat(purchasedInput.value) || 0;
                const endBalance = parseFloat(endBalanceInput.value) || 0;

                // Formula: Fuel Start + Purchased Outside - Fuel End
                const calculatedUsed = startBalance + purchased - endBalance;

                gasolineUsedInput.value = calculatedUsed > 0 ? calculatedUsed.toFixed(2) : '0.00';
                
                // Calculate Gasoline Excess
                calculateGasolineExcess();
            }

            function calculateGasolineExcess() {
                const endBalance = parseFloat(endBalanceInput.value) || 0;
                // Simple logic mapping from user request: Excess implies remaining balance? 
                // Or issued + purchased - used?
                // Let's stick to the prompt's implied logic or simple balance
                gasolineExcessInput.value = endBalance.toFixed(2);
            }

            // Calculate on initial load
            calculateGasolineUsed();

            // Add event listeners
            [gasolineIssuedInput, purchasedInput, startBalanceInput, endBalanceInput].forEach(input => {
                if(input) input.addEventListener('input', calculateGasolineUsed);
            });
        });
    </script>
</div>
