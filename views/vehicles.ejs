<div class="py-10">
  <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 space-y-6">

    <div class="px-6 py-4 bg-gray-50 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-800">Vehicles</h1>
      <button type="button" onclick="document.getElementById('vehicleModal').style.display='block'" class="bg-cao-gold hover:bg-yellow-700 text-white font-bold py-2 px-5 rounded-xl shadow-lg shadow-yellow-700/20 transform transition active:scale-[0.98] hover:shadow-yellow-500/30 inline-flex items-center">
        <i class="fas fa-plus mr-2"></i>New Vehicle
      </button>
    </div>

    <div class="glass-panel rounded-2xl overflow-hidden">
      <div class="p-6">
        <% if (!items || items.length === 0) { %>
          <div class="text-center py-8">
            <p class="text-gray-500">No vehicles found.</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100">
              <thead class="bg-gray-50/50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plate Number</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cylinders</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Normal KPL</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                  <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% items.forEach(function(vehicle) { %>
                  <tr class="hover:bg-yellow-50/50 transition">
                    <td class="px-4 py-4 whitespace-nowrap font-bold text-gray-900"><%= vehicle.plate_number %></td>
                    <td class="px-4 py-4 whitespace-nowrap text-gray-600"><%= vehicle.type %></td>
                    <td class="px-4 py-4 whitespace-nowrap text-gray-600"><%= vehicle.num_of_cylinder %></td>
                    <td class="px-4 py-4 whitespace-nowrap text-gray-600"><%= vehicle.normal_km_per_liter %></td>
                    <td class="px-4 py-4 whitespace-nowrap">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= vehicle.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                        <%= vehicle.is_active ? 'Active' : 'Inactive' %>
                      </span>
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex justify-end gap-2">
                        <button class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-1.5 px-3 rounded-lg text-xs transition">Edit</button>
                        <form action="/vehicles/<%= vehicle.id %>/delete" method="POST" onsubmit="return confirm('Are you sure?');">
                            <button type="submit" class="bg-red-100 hover:bg-red-200 text-red-700 font-medium py-1.5 px-3 rounded-lg text-xs transition">Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Vehicle Modal -->
<div id="vehicleModal" style="display:none;position:fixed;z-index:50;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.5);overflow-y:auto;">
  <div style="margin:5% auto;width:90%;max-width:500px;background:white;border-radius:16px;">
    <div style="padding:20px 24px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#D4AF37 0%,#B8860B 100%);border-radius:16px 16px 0 0;">
      <h3 style="margin:0;font-size:20px;font-weight:700;color:white;">New Vehicle</h3>
      <button type="button" onclick="document.getElementById('vehicleModal').style.display='none'" style="background:none;border:none;font-size:28px;color:white;">&times;</button>
    </div>
    <form method="POST" action="/vehicles">
      <div style="padding:24px;">
        <input type="text" name="plate_number" placeholder="Plate Number" style="width:100%;padding:10px;margin-bottom:10px;border-radius:8px;border:1px solid #d1d5db;" required>
        <input type="text" name="type" placeholder="Type (e.g., SUV)" style="width:100%;padding:10px;margin-bottom:10px;border-radius:8px;border:1px solid #d1d5db;" required>
        <input type="text" name="num_of_cylinder" placeholder="Number of Cylinders" style="width:100%;padding:10px;margin-bottom:10px;border-radius:8px;border:1px solid #d1d5db;" required>
        <input type="number" step="0.01" name="normal_km_per_liter" placeholder="Normal KPL" style="width:100%;padding:10px;margin-bottom:10px;border-radius:8px;border:1px solid #d1d5db;" required>
      </div>
      <div style="padding:16px 24px;border-top:1px solid #e5e7eb;display:flex;justify-content:flex-end;gap:12px;background:#f9fafb;border-radius:0 0 16px 16px;">
        <button type="button" onclick="document.getElementById('vehicleModal').style.display='none'" style="padding:10px 20px;border-radius:8px;background:white;border:1px solid #d1d5db;">Cancel</button>
        <button type="submit" style="padding:10px 20px;border-radius:8px;background:#D4AF37;color:white;border:none;">Create Vehicle</button>
      </div>
    </form>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  window.onclick = (event) => {
    const modal = document.getElementById('vehicleModal');
    if (event.target === modal) modal.style.display = 'none';
  };
});
</script>
