<div class="py-10">
  <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 space-y-6">

    <div class="px-6 py-4 bg-gray-50 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-800">Reports</h1>
    </div>

    <div class="glass-panel rounded-2xl overflow-hidden">
      <div class="p-6">
        <form method="GET" action="/reports">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label for="driver" class="block text-sm font-medium text-gray-700">Driver</label>
              <select name="driver" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
                <option value="">All Drivers</option>
                <% if (drivers && drivers.length) { drivers.forEach(driver => { %>
                  <option value="<%= driver.id %>" <%= (selectedDriver == driver.id) ? 'selected' : '' %>><%= driver.name %></option>
                <% }) } %>
              </select>
            </div>
            <div>
              <label for="month" class="block text-sm font-medium text-gray-700">Month</label>
              <input type="month" name="month" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
            </div>
            <div>
              <button type="submit" class="mt-6 bg-cao-gold hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded">Generate Report</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="glass-panel rounded-2xl overflow-hidden">
        <div class="p-6">
            <% if (!reports || reports.length === 0) { %>
                <div class="text-center py-8">
                    <p class="text-gray-500">No report data to display. Please select filters and generate a report.</p>
                </div>
            <% } else { %>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-100">
                    <thead class="bg-gray-50/50">
                      <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Driver</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Month</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total Distance</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total Fuel Used</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Avg KPL</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total Excess</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                      <% reports.forEach(report => { %>
                        <tr class="hover:bg-yellow-50/50">
                          <td class="px-4 py-4 font-medium"><%= report.driver_name %></td>
                          <td class="px-4 py-4"><%= report.month %></td>
                          <td class="px-4 py-4 text-right font-bold"><%= report.total_distance %> km</td>
                          <td class="px-4 py-4 text-right"><%= report.total_fuel %> L</td>
                          <td class="px-4 py-4 text-right"><%= report.avg_kpl.toFixed(2) %></td>
                          <td class="px-4 py-4 text-right <%= report.total_excess > 0 ? 'text-green-600 font-bold' : 'text-red-600 font-bold' %>"><%= report.total_excess %> L</td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
                <div class="mt-4 flex justify-end">
                  <button onclick="window.print()" class="bg-cao-gold hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded">Print Report</button>
                </div>
            <% } %>
        </div>
    </div>

  </div>
</div>
