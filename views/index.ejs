<div class="py-10">
  <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 space-y-6">
    
    <!-- Hero cards (updated links) -->
    <div class="w-full mx-auto p-8 text-center mb-12">
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/fuel-rivs" class="group">
          <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white p-8 rounded-2xl shadow-2xl hover:shadow-3xl transform hover:-translate-y-2 transition-all duration-300 text-center">
            <i class="fas fa-plus-circle text-4xl mb-4 opacity-90 group-hover:opacity-100"></i>
            <h3 class="text-2xl font-bold mb-2">Fuel RIVs</h3>
            <p class="opacity-90">Manage Fuel RIVs</p>
          </div>
        </a>
        <a href="/trip-tickets" class="group">
          <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 text-white p-8 rounded-2xl shadow-2xl hover:shadow-3xl transform hover:-translate-y-2 transition-all duration-300 text-center">
            <i class="fas fa-list text-4xl mb-4 opacity-90 group-hover:opacity-100"></i>
            <h3 class="text-2xl font-bold mb-2">Trip Tickets</h3>
            <p class="opacity-90">View all fuel tickets</p>
          </div>
        </a>
        <a href="/reports" class="group">
          <div class="bg-gradient-to-br from-purple-500 to-purple-600 text-white p-8 rounded-2xl shadow-2xl hover:shadow-3xl transform hover:-translate-y-2 transition-all duration-300 text-center">
            <i class="fas fa-chart-line text-4xl mb-4 opacity-90 group-hover:opacity-100"></i>
            <h3 class="text-2xl font-bold mb-2">Monthly Reports</h3>
            <p class="opacity-90">Generate monthly summaries</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="glass-panel rounded-3xl p-8 mb-8">
      <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
        <i class="fas fa-info-circle mr-3 text-cao-gold"></i>Quick Stats
      </h2>
      <div class="grid md:grid-cols-4 gap-6 text-center">
        <div class="p-6 bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-2xl border border-yellow-200">
          <i class="fas fa-clock text-3xl text-yellow-600 mb-2"></i>
          <div class="text-3xl font-bold text-gray-800"><%= stats.pending %></div>
          <div class="text-sm text-gray-600 uppercase tracking-wide">Pending Tickets</div>
        </div>
        <div class="p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-2xl border border-green-200">
          <i class="fas fa-check-circle text-3xl text-green-600 mb-2"></i>
          <div class="text-3xl font-bold text-gray-800"><%= stats.completed %></div>
          <div class="text-sm text-gray-600 uppercase tracking-wide">Completed Tickets</div>
        </div>
        <div class="p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl border border-blue-200">
          <i class="fas fa-car text-3xl text-blue-600 mb-2"></i>
          <div class="text-3xl font-bold text-gray-800"><%= stats.vehicles %></div>
          <div class="text-sm text-gray-600 uppercase tracking-wide">Total Vehicles</div>
        </div>
        <div class="p-6 bg-gradient-to-br from-indigo-50 to-indigo-100 rounded-2xl border border-indigo-200">
          <i class="fas fa-id-card text-3xl text-indigo-600 mb-2"></i>
          <div class="text-3xl font-bold text-gray-800"><%= stats.drivers %></div>
          <div class="text-sm text-gray-600 uppercase tracking-wide">Total Drivers</div>
        </div>
      </div>
    </div>

    <!-- Header h2 -->
    <div class="px-6 py-4 bg-gray-50">
      <h2 class="font-semibold text-xl text-gray-800 leading-tight flex items-center">
        <i class="fas fa-route mr-2 text-yellow-600"></i>Dashboard
      </h2>
    </div>

    <!-- Button and Search -->
    <div class="px-6 py-4 bg-gray-50 flex justify-between items-center">
      <button type="button" onclick="document.getElementById('tripModal').style.display='flex'" class="bg-cao-gold hover:bg-yellow-700 text-white font-bold py-2 px-5 rounded-xl shadow-lg shadow-yellow-700/20 transform transition active:scale-[0.98] hover:shadow-yellow-500/30 inline-flex items-center">
        <i class="fas fa-plus mr-2"></i>New Trip Ticket
      </button>
      
      <form method="GET" action="/dashboard" class="flex gap-2">
        <div class="relative">
          <input type="text" name="search" placeholder="Search by Plate No..." class="pl-3 pr-8 py-2 border rounded-xl w-64 focus:ring-yellow-500 focus:border-yellow-500" value="<%= typeof search !== 'undefined' ? search : '' %>">
          <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-yellow-600">
            <i class="fas fa-search"></i>
          </button>
        </div>
      </form>
    </div>

    <!-- Pending Trips glass panel -->
    <div class="glass-panel rounded-2xl overflow-hidden">
      <div class="p-6 border-b border-gray-100">
        <div class="flex items-center gap-3">
          <h3 class="text-lg font-bold text-gray-800">
            <i class="fas fa-clock text-yellow-600 mr-2"></i>Pending Trips
          </h3>
          <span class="bg-yellow-100 text-yellow-800 text-xs font-bold px-2.5 py-1 rounded-full">
            <%= (pendingTrips || []).length %>
          </span>
        </div>
      </div>

      <div class="p-6">
        <% if (!pendingTrips || pendingTrips.length === 0) { %>
          <div class="text-center py-8">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <i class="fas fa-clipboard-check text-gray-400 text-2xl"></i>
            </div>
            <p class="text-gray-500">No pending trips found.</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100">
              <thead class="bg-gray-50/50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ticket No.</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Plate No.</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Driver</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Destination</th>
                  <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% pendingTrips.forEach(function(trip) { %>
                  <tr class="hover:bg-yellow-50/50 transition">
                    <td class="px-4 py-4 whitespace-nowrap">
                      <span class="font-bold text-gray-900">#<%= trip.id %></span>
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        <i class="fas fa-car mr-1"></i><%= trip.plate_number || '' %>
                      </span>
                    </td>
                    <td class="px-4 py-4 whitespace-nowrap text-gray-600"><%= trip.driver_name || '' %></td>
                    <td class="px-4 py-4 whitespace-nowrap text-gray-600"><%= trip.destination || '' %></td>
                    <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex justify-end gap-2">
                        <a href="/trip-tickets/<%= trip.id %>" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-1.5 px-3 rounded-lg text-xs transition">
                          <i class="fas fa-eye mr-1"></i>View
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Trip Ticket Modal -->
<div id="tripModal" style="display:none;position:fixed;z-index:50;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.5);overflow-y:auto;">
  <div style="margin:auto;width:90%;max-width:500px;background:white;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,0.2);">
    <div style="padding:20px 24px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#D4AF37 0%,#B8860B 100%);border-radius:16px 16px 0 0;">
      <h3 style="margin:0;font-size:20px;font-weight:700;color:white;">
        <i class="fas fa-plus-circle mr-2"></i>New Trip Ticket
      </h3>
      <button type="button" onclick="document.getElementById('tripModal').style.display='none'" style="background:none;border:none;font-size:28px;color:white;cursor:pointer;line-height:1;opacity:0.9;">&times;</button>
    </div>
    
    <form method="POST" action="/trip-tickets">
      <div style="padding:24px;">
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">RIV Number (Auto)</label>
          <input type="text" value="<%= typeof nextRiv !== 'undefined' ? nextRiv : '' %>" readonly style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;background-color:#f3f4f6;color:#6b7280;cursor:not-allowed;">
        </div>
        <div style="display:flex;gap:12px;margin-bottom:12px;">
          <div style="flex:1;">
            <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Fuel Type</label>
            <select name="fuel_type" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;" required>
              <option value="Diesel">Diesel</option>
              <option value="Regular">Regular</option>
              <option value="Extra">Extra</option>
            </select>
          </div>
          <div style="flex:1;">
            <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Quantity (L)</label>
            <input type="number" step="0.01" name="fuel_quantity" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;" required>
          </div>
        </div>
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Plate No.</label>
          <input type="text" list="plate_number_list" name="plate_number" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;" placeholder="Type to search..." required autocomplete="off">
          <datalist id="plate_number_list">
            <% if (vehicles && Array.isArray(vehicles)) { vehicles.forEach(v => { %>
              <option value="<%= v.plate_number %>">
            <% }); } %>
          </datalist>
        </div>
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Driver</label>
          <input type="text" list="driver_list" name="driver_name" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;" placeholder="Search driver..." required autocomplete="off">
          <datalist id="driver_list">
            <% if (drivers && Array.isArray(drivers)) { drivers.forEach(d => { %>
              <option value="<%= d.name %>"><%= d.license_number || 'No License' %></option>
            <% }); } %>
          </datalist>
        </div>
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Destination</label>
          <input type="text" name="destination" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;" required>
        </div>
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Authorized Passengers</label>
          <input type="text" name="authorized_passengers" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Purpose</label>
          <textarea name="purpose" rows="2" style="width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;box-sizing:border-box;resize:vertical;"></textarea>
        </div>
      </div>
      <div style="padding:16px 24px;border-top:1px solid #e5e7eb;display:flex;justify-content:flex-end;gap:12px;background:#f9fafb;border-radius:0 0 16px 16px;">
        <button type="button" onclick="document.getElementById('tripModal').style.display='none'" style="padding:10px 20px;border:1px solid #d1d5db;border-radius:8px;background:white;color:#374155;cursor:pointer;font-size:14px;font-weight:500;">Cancel</button>
        <button type="submit" style="padding:10px 20px;border:none;border-radius:8px;background:#D4AF37;color:white;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 4px 14px rgba(212, 175, 55, 0.4);">
          <i class="fas fa-save mr-2"></i>Create Trip Ticket
        </button>
      </div>
    </form>
  </div>
</div>

<style>
.text-yellow-600 { color: #ca8a04; }
.shadow-yellow-700\/20 { box-shadow: 0 10px 15px -3px rgb(212 175 55 / 0.2); }
.shadow-yellow-500\/30 { box-shadow: 0 10px 15px -3px rgb(234 179 8 / 0.3); }
.hover\:bg-yellow-50\/50:hover { background-color: rgb(254 252 232 / 0.5); }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  window.onclick = (event) => {
    const modal = document.getElementById('tripModal');
    if (event.target === modal) modal.style.display = 'none';
  };

  // Check for action query param to open modal on page load
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('action') === 'new_ticket') {
    document.getElementById('tripModal').style.display = 'flex';
  }
});
</script>
