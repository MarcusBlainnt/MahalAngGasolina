<!DOCTYPE html>
<% include('layout') %>
<div class="py-10">
  <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 space-y-6">

    <div class="px-6 py-4 bg-gray-50 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-800">Trip Logs</h1>
      <a href="/dashboard" class="bg-cao-gold hover:bg-yellow-700 text-white font-bold py-2 px-5 rounded-xl shadow-lg shadow-yellow-700/20 transform transition active:scale-[0.98] hover:shadow-yellow-500/30 inline-flex items-center">
        <i class="fas fa-plus mr-2"></i>New Log (via Ticket)
      </a>
    </div>

    <div class="glass-panel rounded-2xl overflow-hidden">
      <div class="p-6">
        <% if (!logs || logs.length === 0) { %>
          <div class="text-center py-8">
            <p class="text-gray-500">No trip logs found.</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100">
              <thead class="bg-gray-50/50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ticket #</th>
                  <th class="px-4 py-3 text-left">Route</th>
                  <th class="px-4 py-3 text-left">Distance (km)</th>
                  <th class="px-4 py-3 text-right">Issued</th>
                  <th class="px-4 py-3 text-right">Used</th>
                  <th class="px-4 py-3 text-right">Outside</th>
                  <th class="px-4 py-3 text-right font-bold text-red-600">Excess</th>
                  <th class="px-4 py-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% logs.forEach(function(log) { %>
                  <tr class="hover:bg-yellow-50/50 transition">
                    <td class="px-4 py-4 whitespace-nowrap font-bold">#<%= log.trip_ticket_id %></td>
                    <td class="px-4 py-4 text-gray-600"><%= log.dep_place %> → <%= log.arr_place %></td>
                    <td class="px-4 py-4 text-gray-600"><%= log.total_distance %></td>
                    <td class="px-4 py-4 text-right text-gray-600"><%= log.gasoline_issued %></td>
                    <td class="px-4 py-4 text-right text-gray-600"><%= log.gasoline_used %></td>
                    <td class="px-4 py-4 text-right text-gray-600"><%= log.gasoline_purchased_outside %></td>
                    <td class="px-4 py-4 text-right font-bold <%= log.gasoline_excess > 0 ? 'text-green-600' : 'text-red-600' %>"><%= log.gasoline_excess %></td>
                    <td class="px-4 py-4 text-right">
                      <a href="/trip-tickets/<%= log.trip_ticket_id %>" class="bg-gray-100 hover:bg-gray-200 text-gray-700 py-1 px-2 rounded text-xs">View</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
